# Kopiraj ovaj fajl u .env i upisi svoje kljuceve.
# Spotify: https://developer.spotify.com/dashboard -> Create app -> Client ID / Client Secret
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Opcionalno: folder gde se snimaju preuzimanja (default: /app/downloads u Dockeru, ~/Music/MusicOne lokalno)
# DOWNLOAD_DIR=/app/downloads

# Opcionalno: residential proxy za spotdl/yt-dlp (YouTube cesto blokira Oracle IP).
# IPRoyal — OSNOVNI URL bez session (session se generise automatski po downloadu):
# MUSICONE_PROXY=http://USERNAME:PASSWORD@geo.iproyal.com:12321
# MUSICONE_PROXY_COUNTRY=de
# MUSICONE_PROXY_LIFETIME=30m
